# Основной адрес сайта: https://ремонтокна.бел/ (xn--80ajphfbebny.xn--90ais), без www, со слэшем в конце.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. http и www (и любые другие хосты) -> https://xn--80ajphfbebny.xn--90ais
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^xn--80ajphfbebny\.xn--90ais$ [NC]
RewriteRule ^ https://xn--80ajphfbebny.xn--90ais%{REQUEST_URI} [R=301,L,NE]

# 2. Множественные слэши: //uslugi//page/ -> /uslugi/page/
RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^?\s]*?)//+([^?\s]*)
RewriteRule ^ https://xn--80ajphfbebny.xn--90ais%1/%2 [R=301,L,NE]

# 3. index.php / index.html / index.htm: /index.php -> /, /uslugi/index.html -> /uslugi/, /index.php/uslugi/ -> /uslugi/
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/([^?\s]*?/)?index\.(?:php|html?)(?:/([^?\s]*))?[?\s] [NC]
RewriteRule ^ https://xn--80ajphfbebny.xn--90ais/%1%2 [R=301,L,NE]

# 4. Слэш в конце для страниц (папок): /uslugi -> /uslugi/
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://xn--80ajphfbebny.xn--90ais/$1/ [R=301,L]

# 5. Служебные страницы ошибок не должны открываться с кодом 200
RewriteRule ^(?:404|_not-found)(?:/.*)?$ - [R=404,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/404\.html[?\s]
RewriteRule ^ - [R=404,L]
</IfModule>

# Служебные файлы Next.js (index.txt, __next.*.txt) не индексировать
<IfModule mod_headers.c>
<FilesMatch "^(?:index|__next\..*)\.txt$">
Header set X-Robots-Tag "noindex, nofollow"
</FilesMatch>
</IfModule>
